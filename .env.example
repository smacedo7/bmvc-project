# PostgreSQL usado pelo Docker Compose
POSTGRES_DB=bmvc
POSTGRES_USER=bmvc
POSTGRES_PASSWORD=bmvc_local
DATABASE_URL=postgresql+psycopg://bmvc:bmvc_local@db:5432/bmvc

# Portas e endereço publicados na máquina
BMVC_BIND_ADDRESS=127.0.0.1
BMVC_WEB_PORT=8080
POSTGRES_PORT=5433

# Aplicação
BMVC_HOST=0.0.0.0
BMVC_COOKIE_SECURE=0
BMVC_DEBUG=0
